# Publisher only. This is never installed with a customer's NAS ledger.
# Keep disabled until merchant approval and real-payment acceptance have passed.
COMMERCE_PAYMENTS_ENABLED=false
COMMERCE_KEYS_DIR=/absolute/private/guizhang-payment-keys
COMMERCE_SIGNING_KEY_FILE=/run/keys/pro-issuer.pem
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY_FILE=/run/keys/alipay-private.pem
ALIPAY_PUBLIC_KEY_FILE=/run/keys/alipay-public.pem
ALIPAY_NOTIFY_URL=https://pay.your-domain.example/v1/commerce/notify/alipay
ALIPAY_SANDBOX=false
WECHAT_APP_ID=
WECHAT_MERCHANT_ID=
WECHAT_MERCHANT_SERIAL=
WECHAT_PLATFORM_SERIAL=
WECHAT_PRIVATE_KEY_FILE=/run/keys/wechat-private.pem
WECHAT_PLATFORM_KEY_FILE=/run/keys/wechat-platform-public.pem
WECHAT_API_V3_KEY_FILE=/run/keys/wechat-api-v3.key
WECHAT_NOTIFY_URL=https://pay.your-domain.example/v1/commerce/notify/wechat
