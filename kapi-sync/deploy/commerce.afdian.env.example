# Publisher only: never bundle these secrets or mount this into a customer NAS.
# Leave closed until a real purchase/refund/recovery acceptance has completed.
COMMERCE_PAYMENTS_ENABLED=false
COMMERCE_KEYS_DIR=/absolute/private/guizhang-payment-keys
COMMERCE_SIGNING_KEY_FILE=/run/keys/pro-issuer.pem
AFDIAN_USER_ID=
AFDIAN_TOKEN_FILE=/run/keys/afdian-token.txt
AFDIAN_PLAN_ID=
# Sale (1) requires the exact one-unit SKU; default is sale, not monthly subscription.
AFDIAN_PRODUCT_TYPE=1
AFDIAN_SKU_ID=
# For a manually reviewed permanent plan (type 0) only; not a monthly Pro licence.
AFDIAN_PERMANENT_PLAN_CONFIRMED=false
