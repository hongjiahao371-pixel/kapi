# Publisher only: never bundle these secrets or mount this into a customer NAS.
# Leave closed by default. Only the official publisher enables sales after verifying the payment and recovery flow.
COMMERCE_PAYMENTS_ENABLED=false
# Comma-separated modern offer IDs explicitly released for Android Afdian sales.
# Leave empty for closed or acceptance-buyer-only operation.
COMMERCE_PUBLIC_OFFERS=
COMMERCE_KEYS_DIR=/absolute/private/guizhang-payment-keys
COMMERCE_SIGNING_KEY_FILE=/run/keys/pro-issuer.pem
AFDIAN_USER_ID=
AFDIAN_TOKEN_FILE=/run/keys/afdian-token.txt
# Optional legacy binding: restores old purchases only; no new 29.90 sales.
AFDIAN_PLAN_ID=
# Sale (1) requires the exact one-unit SKU; default is sale, not monthly subscription.
AFDIAN_PRODUCT_TYPE=1
AFDIAN_SKU_ID=
# For a manually reviewed permanent plan (type 0) only; not a monthly Pro licence.
AFDIAN_PERMANENT_PLAN_CONFIRMED=false

# Three independent one-SKU sale products. Never reuse a plan across tiers.
AFDIAN_MONTHLY_PLAN_ID=
AFDIAN_MONTHLY_SKU_ID=
AFDIAN_YEARLY_PLAN_ID=
AFDIAN_YEARLY_SKU_ID=
AFDIAN_LIFETIME_PLAN_ID=
AFDIAN_LIFETIME_SKU_ID=
# Optional SHA-256 of one acceptance buyer capability. Not the raw capability.
# Only this buyer may create orders in isolated acceptance. Mutually exclusive with public offers.
# Leave payments off until the HTTPS and official checkout are ready.
COMMERCE_ACCEPTANCE_OWNER_HASH=
